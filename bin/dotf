#!/bin/sh
# dotf : installe, met à jour et désinstalle l'environnement shell.
set -eu

_self=$(readlink -f "$0" 2>/dev/null || echo "$0")
DOTF=$(cd "$(dirname "$_self")/.." && pwd -P)
DOTF_LOCAL=${DOTF_LOCAL:-${XDG_CONFIG_HOME:-$HOME/.config}/dotf}
DOTF_STATE=${DOTF_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/dotf}
export DOTF DOTF_LOCAL DOTF_STATE

for _lib in log state hooks git repo guard links modules; do
  # shellcheck source=/dev/null
  . "$DOTF/lib/$_lib.sh"
done

# Le chemin est écrit entre apostrophes dans les lignes de branchement.
case $DOTF in
  *"'"* | *' '*) die "le chemin du dépôt ne doit contenir ni espace ni apostrophe : $DOTF" ;;
esac

load_local_config() {
  # shellcheck source=/dev/null
  if [ -r "$DOTF_LOCAL/config.sh" ]; then . "$DOTF_LOCAL/config.sh"; fi
}

usage() {
  cat <<EOF
Usage : dotf <commande>

  install            branche les shells, pose les liens, installe les modules (relançable)
  update             git pull, puis install avec mise à jour des modules
  uninstall [--purge]
                     débranche tout et restaure les sauvegardes ;
                     --purge supprime aussi le dépôt et l'état (jamais la config locale)
  status             état des branchements, liens, modules et du dépôt
  edit               ouvre la config locale de la machine
  theme [dark|light|toggle]
                     thème Catppuccin sombre (mocha) ou clair (latte) ; sans argument : bascule
  scan [--all]       garde-fou anti-fuite sur ce qui va être commité, ou sur tout le dépôt

Dépôt         : $(tilde "$DOTF")
Config locale : $(tilde "$DOTF_LOCAL")
État          : $(tilde "$DOTF_STATE")
EOF
}

cmd_install() {
  log_step "Config locale"
  if [ -d "$DOTF_LOCAL" ]; then
    log_info "$(tilde "$DOTF_LOCAL") : existe déjà"
  else
    mkdir -p "$(dirname "$DOTF_LOCAL")"
    cp -R "$DOTF/local.example" "$DOTF_LOCAL"
    log_ok "$(tilde "$DOTF_LOCAL") : créée depuis local.example"
  fi
  load_local_config

  log_step "Branchement des shells"
  hooks_install
  log_step "Git"
  git_install
  log_step "Garde-fou anti-fuite"
  guard_install
  log_step "Dépôt"
  repo_install
  log_step "Liens"
  links_install
  _mods=$(module_list | paste -sd ' ' -)
  log_step "Modules (${_mods:-aucun})"
  if [ "${1-}" = --update ]; then module_sync update; else module_sync; fi

  echo
  echo "Terminé. Ouvrir un nouveau shell (ou « exec \$SHELL ») pour en profiter."
}

cmd_update() {
  log_step "Mise à jour du dépôt"
  repo_pull
  # La nouvelle version de dotf fait la suite.
  exec "$DOTF/bin/dotf" install --update
}

cmd_uninstall() {
  log_step "Débranchement des shells"
  hooks_remove
  log_step "Git"
  git_remove
  log_step "Garde-fou anti-fuite"
  guard_remove
  log_step "Liens"
  links_remove
  log_step "Modules"
  module_remove_all

  if [ "${1-}" = --purge ]; then
    log_step "Purge"
    repo_dirty && die "$(tilde "$DOTF") contient des modifications non commitées ou non poussées : purge annulée (le reste est déjà désinstallé)"
    rm -rf "$DOTF_STATE" "$DOTF"
    log_ok "$(tilde "$DOTF_STATE") et $(tilde "$DOTF") : supprimés"
  fi

  echo
  echo "Désinstallé. La config locale est conservée : $(tilde "$DOTF_LOCAL")"
}

cmd_status() {
  load_local_config
  log_step "Dépôt $(tilde "$DOTF")"
  repo_status
  log_step "Branchement des shells"
  hooks_status
  log_step "Git"
  git_status
  log_step "Garde-fou anti-fuite"
  guard_status
  log_step "Liens"
  links_status
  log_step "Modules"
  module_status
  log_step "Config locale $(tilde "$DOTF_LOCAL")"
  if [ -d "$DOTF_LOCAL" ]; then log_ok "présente"; else log_warn "absente : « dotf install » la crée"; fi
}

cmd_edit() {
  [ -d "$DOTF_LOCAL" ] || die "pas de config locale : lancer « dotf install »"
  exec "${VISUAL:-${EDITOR:-vi}}" "$DOTF_LOCAL/config.sh"
}

cmd_theme() {
  case ${1-toggle} in
    dark) _t=mocha ;;
    light) _t=latte ;;
    toggle) if [ "$(cat "$DOTF_STATE/theme" 2>/dev/null)" = latte ]; then _t=mocha; else _t=latte; fi ;;
    *) die "usage : dotf theme [dark|light|toggle]" ;;
  esac
  mkdir -p "$DOTF_STATE" && echo "$_t" >"$DOTF_STATE/theme"
  # Les vim en cours rechargent leur thème (autocommande SigUSR1 du vimrc).
  pkill -USR1 -u "$(id -u)" -x 'g?vim|vi|vim\..*|nvim' 2>/dev/null || true
  log_ok "thème $_t : terminaux au prochain prompt, vim tout de suite, broot et gitui au prochain lancement"
  [ -z "${DOTF_THEME_SSH-}" ] || log_warn "cette session ssh suit le thème du poste ($DOTF_THEME_SSH)"
}

cmd_scan() {
  case ${1---pre-commit} in
    --pre-commit) _mode=staged _what="modifications prêtes à commiter" ;;
    --pre-push) _mode=pre-push _what="commits à pousser" ;;
    --all) _mode=all _what="tout le dépôt" ;;
    *) die "usage : dotf scan [--all]" ;;
  esac
  if guard_scan "$_mode"; then
    if [ "$_mode" = all ]; then log_ok "aucune fuite détectée ($_what)"; fi
    return 0
  fi
  cat >&2 <<EOF

dotf : fuite possible détectée ($_what), opération refusée.
  - retirer la donnée (la placer dans $(tilde "$DOTF_LOCAL") si elle est utile) ;
  - ou, si c'est un faux positif, ajouter le commentaire « dotf-allow » sur la ligne.
EOF
  exit 1
}

_cmd=${1-help}
[ $# -gt 0 ] && shift
case $_cmd in
  install) cmd_install "$@" ;;
  update) cmd_update ;;
  uninstall) cmd_uninstall "$@" ;;
  status) cmd_status ;;
  edit) cmd_edit ;;
  theme) cmd_theme "$@" ;;
  scan) cmd_scan "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
