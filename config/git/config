# Config git commune, incluse depuis ~/.gitconfig par dotf.
# ~/.config/dotf/gitconfig (propre à la machine) est inclus à la fin : il a le dernier mot.

[user]
	name = Gauthier
[init]
	defaultBranch = main
[pull]
	ff = only
[fetch]
	prune = true             # oublie les branches supprimées sur le serveur
[push]
	autoSetupRemote = true   # premier push d'une branche sans -u
[diff]
	algorithm = histogram
[merge]
	tool = meld
	conflictStyle = zdiff3   # les conflits montrent aussi la version d'origine
[credential]
	helper = cache

[include]
	path = ~/.config/dotf/gitconfig
