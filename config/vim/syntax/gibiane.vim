" Procédure appelée avec @ (fournie ou non).
syn match gibianeProcedure /@\w\+/

" Les mots-clés s'écrivent souvent entre apostrophes : 'SI', 'FIN'…
syn cluster gibianeWords contains=gibianeType,gibianeElement,gibianeOperator,gibianeFunction,gibianeProcedure,gibianeConditional,gibianeLoop,gibianeLogical,gibianeProcPerso,gibianeError
syn region gibianeString start=/'/ end=/'/ oneline contains=@gibianeWords
syn region gibianeString start=/"/ end=/"/ oneline contains=@gibianeWords

syn match gibianeNumber /\<\d\+\>/
syn match gibianeFloat /\<\d\+\.\d*\%([ed][-+]\=\d\+\)\=/
syn match gibianeFloat /\.\d\+\%([ed][-+]\=\d\+\)\=\>/
syn match gibianeFloat /\<\d\+[ed][-+]\=\d\+\>/

syn keyword gibianeTodo TODO contained
syn match gibianeComment /^\*.*$/ contains=gibianeTodo

" Au-delà de la longueur maximale d'une ligne.
syn match gibianeTooLong /\%>972v.\+/

hi def link gibianeType Structure
hi def link gibianeElement Type
hi def link gibianeOperator Function
hi def link gibianeFunction Function
hi def link gibianeProcedure Function
hi def link gibianeConditional Conditional
hi def link gibianeLoop Repeat
hi def link gibianeLogical Boolean
hi def link gibianeProcPerso Macro
hi def link gibianeError Exception
hi def link gibianeString String
hi def link gibianeNumber Number
hi def link gibianeFloat Float
hi def link gibianeTodo Todo
hi def link gibianeComment Comment
hi def link gibianeTooLong Error

let b:current_syntax = 'gibiane'
