" Config vim commune, chargée depuis ~/.vimrc par dotf.
" ~/.config/dotf/vimrc (propre à la machine) est chargé à la fin : il a le dernier mot.

" UTF-8 même sous une locale C (le dictionnaire français est en UTF-8).
set encoding=utf-8

" Runtime : config locale (prioritaire), dépôt, plugins installés en modules (~/.local/opt/vim-*).
let s:dotf = fnamemodify(resolve(expand('<sfile>:p')), ':h:h:h')
let s:local = empty($DOTF_LOCAL) ? expand('~/.config/dotf') : $DOTF_LOCAL
function! s:rtp_prepend(dir) abort
  if index(split(&runtimepath, ','), a:dir) < 0
    let &runtimepath = a:dir . ',' . &runtimepath
  endif
endfunction
for s:dir in glob('~/.local/opt/vim-*', 1, 1)
  call s:rtp_prepend(s:dir)
endfor
call s:rtp_prepend(s:dotf . '/config/vim')
" La config locale passe en premier : vim écrit les mots ajoutés (zg) dans son dossier spell, s'il existe.
call s:rtp_prepend(s:local . '/vim')
if !isdirectory(s:local . '/vim/spell')
  call mkdir(s:local . '/vim/spell', 'p')
endif

" Réglages de base de vim, qu'il saute dès qu'un ~/.vimrc existe. Après le runtime : ils activent la détection des types de fichiers.
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

" Thème Catppuccin du mode choisi par « dotf theme » (module vim-catppuccin), sinon un thème fourni avec vim.
" Fautes d'orthographe soulignées dans le terminal, quel que soit le thème.
augroup dotf_colors
  autocmd!
  autocmd ColorScheme * hi SpellBad cterm=underline ctermfg=NONE ctermbg=NONE
augroup END
if $COLORTERM =~# 'truecolor\|24bit'
  set termguicolors
endif
let s:theme_file = expand('~/.local/state/dotf/theme')
let s:theme = !empty($DOTF_THEME) ? $DOTF_THEME : filereadable(s:theme_file) ? get(readfile(s:theme_file), 0, 'mocha') : 'mocha'
try
  execute 'colorscheme catppuccin_' . s:theme
catch
  set background=dark
  silent! colorscheme habamax
endtry

" Barre d'état lightline (module vim-lightline), aux couleurs du thème ; le mode y est affiché.
" Séparateurs en flèche : police Nerd Font.
if !empty(globpath(&runtimepath, 'plugin/lightline.vim'))
  set laststatus=2 noshowmode
  let g:loaded_airline = 1 " un airline installé par le système prendrait la barre
  let g:lightline = {
        \ 'separator': {'left': "\ue0b0", 'right': "\ue0b2"},
        \ 'subseparator': {'left': "\ue0b1", 'right': "\ue0b3"},
        \ }
  if get(g:, 'colors_name', '') =~# '^catppuccin_'
    let g:lightline.colorscheme = g:colors_name
  endif
endif

" gvim
set guifont=Hasklug\ Nerd\ Font\ Mono\ 11
set guioptions-=T

" Orthographe
command! Spellfr setlocal spell spelllang=fr
command! Spellen setlocal spell spelllang=en
command! Spellno setlocal nospell

" Affichage et fenêtres
set cursorline
set splitright
set visualbell
" Souris pour vim ; Maj + clic : sélection et collage par le terminal (marche aussi en ssh).
set mouse=a
set mousemodel=popup
nnoremap <F9> :set number!<CR>
nnoremap <F10> :set relativenumber!<CR>

" Recherche de fichiers (:find dans les sous-dossiers), explorateur netrw en arbre
set path+=**
let g:netrw_banner = 0
let g:netrw_liststyle = 3

" Indentation : 3 espaces ; recherche insensible à la casse
set expandtab tabstop=3 softtabstop=3 shiftwidth=3
set smartindent
set ignorecase

" Fortran : tabulations autorisées
let g:fortran_have_tabs = 1

if filereadable(s:local . '/vimrc')
  execute 'source' fnameescape(s:local . '/vimrc')
endif
