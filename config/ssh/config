# Config ssh commune, incluse à la fin de ~/.ssh/config par dotf, après ~/.config/dotf/ssh_config.
# ssh garde la première valeur trouvée : ces réglages par défaut ne passent qu'après les tiens.

Host *
  # Thème et couleurs 24 bits du poste transmis à la session distante (voir « dotf theme »).
  SendEnv LC_DOTF_THEME LC_DOTF_COLORTERM
  # Connexion maintenue (pare-feu, NAT) ; abandon après 3 minutes sans réponse.
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Les connexions suivantes vers le même hôte réutilisent la première, pendant 10 minutes.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  AddKeysToAgent yes
